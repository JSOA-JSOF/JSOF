{
  "name": "jsoa-jsof-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:gate": "node scripts/audit-gate.mjs",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "ci": "npm run typecheck && npm test && npm run audit:gate && npm run build",
    "db:list": "wrangler d1 migrations list jsoa-platform --remote",
    "db:migrate": "wrangler d1 migrations apply jsoa-platform --remote",
    "db:migrate:local": "wrangler d1 migrations apply jsoa-platform",
    "dev": "next dev",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.0.1",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.152.0"
  }
}
